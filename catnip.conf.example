# catnip configuration — KEY=value, '#' comments.
#
# Resolution order (first wins): environment > this file > ./catnip.conf >
# ~/.config/catnip/catnip.conf > built-in defaults.
# See `catnip config` for what is actually in effect right now.

# Whose repositories to collect. Leave empty to use the authenticated
# `gh` account. Traffic data requires push access, so this is normally
# you or an organization you administer.
CATNIP_OWNER=YOUR-GITHUB-USERNAME

# auto | user | org — auto tries the org endpoint, then the user one.
CATNIP_OWNER_TYPE=auto

# Everything catnip writes lives here: runs/, stats/, logs/.
# CATNIP_DATA_DIR=~/.local/share/catnip   # blank = XDG default

# Repo selection. Space-separated glob patterns against the bare repo
# name. Empty CATNIP_INCLUDE means "everything not excluded".
CATNIP_INCLUDE=
CATNIP_EXCLUDE=
CATNIP_INCLUDE_FORKS=false
CATNIP_INCLUDE_ARCHIVED=true
CATNIP_INCLUDE_PRIVATE=true

# Optional endpoints, each costing API calls per repo per run. Turn
# these off first if a large account runs into the hourly rate limit.
CATNIP_FETCH_STATS=true
CATNIP_FETCH_README=true
CATNIP_FETCH_EVENTS=true
CATNIP_FETCH_ISSUES=true

# How long run directories survive `catnip prune`. The history store is
# never pruned — it is the only copy of traffic days older than the ~14
# GitHub still serves.
CATNIP_RETAIN_DAYS=30

# How long GitHub keeps adding counts to a day after it closes. Measured at
# 36h on one account (docs/metrics.md): a day read 12h after closing carried
# a third of its final views. No window ends inside this wait, so raising it
# moves every window further back. 36 is a floor — a lower value is ignored,
# because a short wait publishes part of a day as all of it.
# `catnip settle` measures what this account actually does and says when
# this needs raising; `catnip doctor` warns when the readings contradict it.
CATNIP_SETTLE_HOURS=36

# How many days of settle readings to keep in
# stats/history/daily_snapshots.jsonl. That file grows per fetch per repo
# per day and is a measurement, not a record: every day in it is already in
# the store at its settled value, so trimming loses only the history of how
# long that took. `catnip prune` deliberately does not bound it — prune now
# keeps runs whose days may still be revised.
CATNIP_SETTLE_LOG_DAYS=90

# Timer cadence (systemd OnCalendar syntax) and jitter. Daily is the floor
# that keeps the 14-day traffic window from developing holes; every six
# hours is the default because GitHub keeps revising a day for the wait
# above, and a daily read can only place a revision to within 24 hours.
# Collecting more often does not make a day settle sooner — the wait is
# GitHub's, not a sampling artifact — but it does bound when the count
# stopped moving, and it recomputes the unsettled report four times a day
# instead of once.
#
# The jitter is additive: systemd starts somewhere in the 40 minutes after
# the OnCalendar time, which is the +/-20m spread measured from its middle.
CATNIP_TIMER_ONCALENDAR=*-*-* 00/6:00:00
CATNIP_TIMER_RANDOM_DELAY=40m
