# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- analysis reports ---
# `catnip report` writes to CATNIP_DATA_DIR/reports by default, outside
# the checkout. This covers a local --out-dir pointed here: a report
# names private repositories and their traffic.
reports/

# --- catnip's own data and configuration ---
# Collected runs live in CATNIP_DATA_DIR (~/.local/share/catnip by
# default), never in the checkout — but a local override or an old
# repo-relative layout would land here, and traffic data for private
# repositories is not something to commit by accident.
catnip.conf
/data/
/runs/
/stats/
*.log

# --- Raw demo recordings ---
# The published GIF is committed under docs/media/; the cast and working
# takes it was rendered from are regenerable with the record toolkit.
recordings/

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Local, per-machine agent settings ---
.claude/settings.local.json
.claude/settings.json
.cursor/settings.json

# --- Local secrets ---
.env
*.pem
*.key
*.bak
