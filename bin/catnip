#!/usr/bin/env bash
# catnip — GitHub traffic analytics you own, on a timer.
#
# One dispatcher over the pipeline in src/catnip/. Every subcommand
# resolves its own configuration through catnip.config, so `catnip run`
# from a systemd timer and `catnip analyze` typed by hand always agree
# about which account and which data directory are in play.
set -euo pipefail

# Everything below lives inside main(), called on the last line, because bash
# reads a script INCREMENTALLY rather than slurping it. `catnip run` is a
# 40-minute job, and rewriting this file in place while one is in flight —
# a `git pull`, an editor save — moves the bytes under bash's stored offset.
#
# Measured, not assumed. With an in-place rewrite mid-run, an unwrapped
# script loses the rest of its body: execution dies at the corruption and
# the remaining work never happens. Wrapped, bash must parse the whole
# function before it can execute the call, so the body always completes.
#
# It is not a total fix and nothing is: bash may still read garbage after
# main() returns and exit non-zero having done all the work correctly. An
# `exit` after the call does not help, because the corrupted bytes can
# precede it. Treat a trailing syntax error from a run that otherwise
# reported success as this, and check the store rather than the exit code.
#
# Editors that write-then-rename (sed -i, vim's default) are safe: the
# running shell keeps the original inode.
main() {
HERE="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd -- "$HERE/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
PYTHON="${CATNIP_PYTHON:-python3}"

usage() {
  cat <<'USAGE'
catnip — GitHub repository and traffic analytics, collected on a timer.

Usage: catnip <command> [options]

Getting started
  init            Write a config file (interactive; --owner/--force to script it)
  doctor          Check tooling, credentials, access, and data. Start here when
                  anything is wrong. --json for machine-readable output.
  config          Show the resolved configuration and every path it implies

Collecting
  run             fetch -> analyze -> history -> totals -> verify (the timer target;
                  --jitter N waits a random 0..N seconds first, for schedulers
                  with no randomized delay of their own — never with systemd's)
  fetch           Collect raw API data into a new run directory (--dry-run to preview)
  analyze         Turn a run's raw JSON into analysis CSVs (default: newest run)
  history         Ingest runs into the permanent history store
  totals          Rebuild account-wide totals across every run
  verify          Assert that every artifact the TUI reads exists

Reading
  tui             Interactive terminal UI ([enter] drills into a repo, [?] explains
                  any score). Works store-only when no run survives pruning
  view VIEW       Print one view as text (traffic, audience, table, deltas,
                  anomaly, profile, correlation, funnel, lang,
                  attribution)
  report          Write a deterministic markdown analysis of the store
                  (--stdout to print, --force to bypass the interval guard,
                  --locate to print the newest report's paths as JSON)
  settle          Measure how long GitHub kept revising each recent day, and
                  say whether that contradicts CATNIP_SETTLE_HOURS
  summary         Print the newest run's summary.md
  runs            List run directories

Maintenance
  prune           Delete old runs — never one missing from the history store
  timer           install | uninstall | status | logs | print | cron
  version         Print the catnip version

Configuration lives in ./catnip.conf, $CATNIP_CONFIG, or
~/.config/catnip/catnip.conf. Any CATNIP_* environment variable overrides it.
USAGE
}

# A --config anywhere on the line becomes the environment for every stage.
# `catnip run --config work.conf` has to reach analyze, history, and totals
# too, not just the fetch it was typed next to — a pipeline where the
# stages read different config files is the worst kind of wrong, because
# each stage individually succeeds.
for ((i = 1; i <= $#; i++)); do
  if [[ "${!i}" == "--config" ]]; then
    j=$((i + 1))
    [[ $j -le $# ]] || { echo "catnip: --config needs a file argument" >&2; exit 2; }
    export CATNIP_CONFIG="${!j}"
    break
  fi
done

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  -h|--help|help) usage ;;

  init)     exec "$PYTHON" -m catnip.init "$@" ;;
  doctor)   exec "$PYTHON" -m catnip.doctor "$@" ;;
  # --show is the default, but it is one of a mutually exclusive group, so
  # hardcoding it made `catnip config --json` argparse-error every time —
  # a documented agent surface that never once worked. Only supply the
  # default when the caller named no mode of their own.
  config)
    case " $* " in
      *" --json "*|*" --shell "*|*" --select "*|*" --show "*)
        exec "$PYTHON" -m catnip.config "$@" ;;
      *)
        exec "$PYTHON" -m catnip.config --show "$@" ;;
    esac ;;

  fetch)    exec bash "$ROOT/src/catnip/fetch.sh" "$@" ;;
  analyze)  exec "$PYTHON" -m catnip.analyze "$@" ;;
  history)  exec "$PYTHON" -m catnip.history "$@" ;;
  totals)   exec "$PYTHON" -m catnip.totals "$@" ;;
  prune)    exec "$PYTHON" -m catnip.prune "$@" ;;
  timer)    exec "$PYTHON" -m catnip.timer "$@" ;;
  tui)      exec "$PYTHON" -m catnip.ui "$@" ;;
  report)   exec "$PYTHON" -m catnip.report "$@" ;;
  settle)   exec "$PYTHON" -m catnip.settle "$@" ;;
  verify)   exec "$PYTHON" -m catnip.doctor --data-only "$@" ;;

  view)
    view="${1:-traffic}"; [[ $# -gt 0 ]] && shift || true
    # `catnip view why <name>` reads naturally and is what the docs and the
    # prowl skill both use, so accept it here rather than making callers
    # spell out --why-view.
    if [[ "$view" == "why" && $# -gt 0 && "$1" != -* ]]; then
      why="$1"; shift
      exec "$PYTHON" -m catnip.ui --text --view why --why-view "$why" "$@"
    fi
    exec "$PYTHON" -m catnip.ui --text --view "$view" "$@" ;;

  runs)
    exec "$PYTHON" - "$@" <<'PY'
import sys
from catnip.config import Config, run_dirs
cfg = Config.load()
runs = run_dirs(cfg.runs_dir)
if not runs:
    print(f"No runs under {cfg.runs_dir}. Collect one with: catnip run", file=sys.stderr)
    raise SystemExit(1)
for run in runs:
    analyzed = "analyzed" if (run / "analysis").is_dir() else "raw only"
    print(f"{run.name}  {analyzed}  {run}")
PY
    ;;

  summary)
    exec "$PYTHON" - "$@" <<'PY'
import sys
from catnip.config import Config
run = Config.load().latest_run()
if run is None:
    print("No runs yet. Collect one with: catnip run", file=sys.stderr)
    raise SystemExit(1)
summary = run / "analysis" / "summary.md"
if not summary.is_file():
    print(f"{run.name} has no summary — run: catnip analyze", file=sys.stderr)
    raise SystemExit(1)
sys.stdout.write(summary.read_text(encoding="utf-8"))
PY
    ;;

  version)
    exec "$PYTHON" -c "import catnip; print('catnip', catnip.__version__)" ;;

  # The whole pipeline, in dependency order. This is what the systemd timer
  # runs. `history` must come before `prune` ever deletes anything, which is
  # why prune is not part of it — pruning is an explicit act, never a side
  # effect of collecting.
  run)
    QUIET=false
    JITTER=0
    ARGS=()
    while (($#)); do
      case "$1" in
        --quiet) QUIET=true; shift ;;
        # Not `shift 2 || true`: with one argument left that shift fails and
        # shifts nothing, so the loop reads --jitter again, forever.
        --jitter)
          [[ $# -ge 2 ]] || { echo "catnip: --jitter needs a value in seconds" >&2; exit 2; }
          JITTER="$2"; shift 2 ;;
        --jitter=*) JITTER="${1#*=}"; shift ;;
        *) ARGS+=("$1"); shift ;;
      esac
    done

    # Start-time variability for schedulers that have none of their own.
    # systemd has RandomizedDelaySec and does not need this; leather's cron
    # fires at the exact matching minute (internal/scheduler/cron.go computes
    # the next time by incremental matching, with no random offset anywhere),
    # and launchd's StartCalendarInterval is equally exact. Without it every
    # tannery on every machine hits the API at :07.
    #
    # Never combine the two. A unit that already carries RandomizedDelaySec
    # and also passes --jitter waits twice, and the second wait is invisible
    # in `systemctl list-timers`.
    if ! [[ "$JITTER" =~ ^[0-9]+$ ]]; then
      echo "catnip: --jitter takes a whole number of seconds, got '${JITTER}'" >&2
      exit 2
    fi
    if ((JITTER > 0)); then
      # $RANDOM is a bashism and this script is bash. The cron line printed by
      # `catnip timer cron` cannot use it — cron runs commands under /bin/sh.
      wait=$((RANDOM % (JITTER + 1)))
      echo "catnip run: waiting ${wait}s before collecting (jitter up to ${JITTER}s)" >&2
      sleep "$wait"
    fi

    log="$(mktemp)"; trap 'rm -f "$log"' EXIT
    step() {
      local label="$1"; shift
      if $QUIET; then
        if ! "$@" >"$log" 2>&1; then
          echo "catnip run: FAILED at '$label'" >&2
          tail -n 40 "$log" >&2
          return 1
        fi
        tail -n 1 "$log"
      else
        echo "==> $label" >&2
        "$@" || { echo "catnip run: FAILED at '$label'" >&2; return 1; }
      fi
    }

    step fetch   bash "$ROOT/src/catnip/fetch.sh" ${ARGS[@]+"${ARGS[@]}"} &&
    step analyze "$PYTHON" -m catnip.analyze &&
    step history "$PYTHON" -m catnip.history &&
    step totals  "$PYTHON" -m catnip.totals &&
    step verify  "$PYTHON" -m catnip.doctor --data-only
    ;;

  *)
    echo "catnip: unknown command '$cmd'" >&2
    echo >&2
    usage >&2
    exit 2 ;;
esac
}

main "$@"
